# Mode chain (opsional). Tanpa kunci di bawah, app berjalan dengan data contoh.
# Isi dengan kunci TESTNET saja, jangan pernah kunci mainnet. Di mesin dev tanpa env ini,
# server membaca ~/.lummy/testnet.env (Arbitrum Sepolia). Nama dari file itu juga diterima
# (OPERATOR_PRIVATE_KEY, BUYER_PRIVATE_KEY, SELLER_ADDRESS). Jangan unggah DEPLOYER_PRIVATE_KEY
# (admin kontrak) atau SELLER_PRIVATE_KEY ke hosting: server tidak membutuhkannya.
LUMMY_OPERATOR_KEY=
LUMMY_BUYER_KEY=
LUMMY_SELLER_ADDRESS=

# Wajib di produksi (Vercel): tanpa ini route tulis ditolak. Presenter mengisinya di Dev Panel.
LUMMY_DEMO_KEY=

# Opsional. Default: Arbitrum Sepolia, alamat dari src/lib/chain/deployments.ts, 1 USDC per pesanan.
# LUMMY_CHAIN_ID=421614
# LUMMY_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
# LUMMY_ESCROW=
# LUMMY_TOKEN=
# LUMMY_DEMO_PRICE_USDC=1
