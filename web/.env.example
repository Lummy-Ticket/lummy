# Salin jadi web/.env.local (di-ignore git, dibaca otomatis oleh next dev dan next build).
# Di Vercel, isi nama yang sama di Project Settings → Environment Variables.

# Supabase (project lummy). Tanpa ini, app berjalan dengan data contoh.
# URL dan publishable key memang publik (ikut ke browser); yang menjaga data adalah RLS.
NEXT_PUBLIC_SUPABASE_URL=https://tnszimamfpuaqjrdynbu.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_9QjeGwuWLLkTdzgyLVo3CQ_K0s0yYOB
# RAHASIA, server saja: menembus RLS. Dashboard → Project Settings → API Keys → Secret keys.
# Dipakai untuk akun demo (Dev Panel) dan nanti semua tulisan server. Jangan pakai awalan NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Pembaca tiket PDF (opsional). Tanpa ini, halaman Jual memakai tiket contoh. RAHASIA, server saja:
# kunci HMAC untuk barcode tiket, minimal 32 karakter acak (mis. `openssl rand -base64 48`).
# Buat sekali dan jangan pernah diganti: barcode yang sudah tersimpan cuma cocok dengan pepper yang
# sama, jadi menggantinya membuat tiket yang sudah dijual bisa dipasang lagi.
TICKET_BARCODE_PEPPER=

# Mode chain (opsional). Tanpa kunci di bawah, app berjalan dengan data contoh.
# Isi dengan kunci TESTNET saja, jangan pernah kunci mainnet. Di mesin dev tanpa env ini,
# server membaca ~/.lummy/testnet.env (Arbitrum Sepolia). Nama dari file itu juga diterima
# (OPERATOR_PRIVATE_KEY, BUYER_PRIVATE_KEY, SELLER_ADDRESS). Jangan unggah DEPLOYER_PRIVATE_KEY
# (admin kontrak) atau SELLER_PRIVATE_KEY ke hosting: server tidak membutuhkannya.
LUMMY_OPERATOR_KEY=
LUMMY_BUYER_KEY=
LUMMY_SELLER_ADDRESS=

# Wajib di produksi (Vercel): tanpa ini route tulis mode chain dan akun demo ditolak. Presenter
# mengisinya di Dev Panel.
LUMMY_DEMO_KEY=

# Opsional. Default: Arbitrum Sepolia, alamat dari src/lib/chain/deployments.ts, 1 USDC per pesanan.
# LUMMY_CHAIN_ID=421614
# LUMMY_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
# LUMMY_ESCROW=
# LUMMY_TOKEN=
# LUMMY_DEMO_PRICE_USDC=1
