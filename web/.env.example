# Salin jadi web/.env.local (di-ignore git, dibaca otomatis oleh next dev dan next build).
# Di Vercel, isi nama yang sama di Project Settings → Environment Variables.

# Supabase (project lummy). Tanpa ini, app berjalan dengan data contoh.
# URL dan publishable key memang publik (ikut ke browser); yang menjaga data adalah RLS.
NEXT_PUBLIC_SUPABASE_URL=https://tnszimamfpuaqjrdynbu.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_9QjeGwuWLLkTdzgyLVo3CQ_K0s0yYOB
# RAHASIA, server saja: menembus RLS. Dashboard → Project Settings → API Keys → Secret keys.
# Dipakai untuk akun demo (Dev Panel) dan nanti semua tulisan server. Jangan pakai awalan NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Pembaca tiket PDF (opsional). Tanpa ini, halaman Jual memakai tiket contoh. RAHASIA, server saja:
# kunci HMAC untuk barcode tiket, minimal 32 karakter acak (mis. `openssl rand -base64 48`).
# Buat sekali dan jangan pernah diganti: barcode yang sudah tersimpan cuma cocok dengan pepper yang
# sama, jadi menggantinya membuat tiket yang sudah dijual bisa dipasang lagi.
TICKET_BARCODE_PEPPER=

# Mode chain (opsional). Tanpa kunci di bawah, app berjalan dengan data contoh.
# Isi dengan kunci TESTNET saja, jangan pernah kunci mainnet. Di mesin dev tanpa env ini,
# server membaca ~/.lummy/testnet.env (Arbitrum Sepolia). Nama dari file itu juga diterima
# (OPERATOR_PRIVATE_KEY, BUYER_PRIVATE_KEY, SELLER_ADDRESS). Jangan unggah DEPLOYER_PRIVATE_KEY
# (admin kontrak) atau SELLER_PRIVATE_KEY ke hosting: server tidak membutuhkannya.
LUMMY_OPERATOR_KEY=
LUMMY_BUYER_KEY=
LUMMY_SELLER_ADDRESS=

# Buku besar pesanan QRIS (docs/09 §7, opsional): kunci operator khusus, supaya nonce-nya tidak berebut
# dengan checkout escrow. Tanpa ini, buku besar memakai LUMMY_OPERATOR_KEY (punya OPERATOR_ROLE di
# kedua kontrak). Alamatnya perlu diberi OPERATOR_ROLE di LummyLedger oleh admin dulu.
# LUMMY_LEDGER_KEY=

# Wajib di produksi (Vercel): tanpa ini route tulis mode chain dan akun demo ditolak. Presenter
# mengisinya di Dev Panel.
LUMMY_DEMO_KEY=

# Pengaman route cron harian (opsional, disarankan di Production). Kalau ada, /api/cron/daily cuma
# menerima "Authorization: Bearer <nilai>", yang dikirim Vercel Cron sendiri. Nilai acak
# (bash web/scripts/set-secret.sh CRON_SECRET --generate). docs/config/04-vercel-env-cron.md
CRON_SECRET=

# Xendit, pembayaran QRIS (docs/09 §6). RAHASIA, server saja. Kunci test diawali xnd_development_
# (checkout menampilkan tombol simulasi), kunci live cuma di Production. Tanpa keduanya, akun memakai
# pembayaran simulasi. Simpan dengan web/scripts/set-secret.sh. docs/config/02-xendit.md
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=

# Email dari app selain link login (opsional, src/lib/email): pesanan dibayar, klaim dan putusannya,
# acara batal, dan notifikasi tiket baru. Cuma terkirim kalau FEATURES.emails (src/lib/features.ts)
# true DAN SMTP_HOST, SMTP_USER, SMTP_PASSWORD, MAIL_FROM ada; tanpa itu app diam saja. Lewat
# Mailspace, satu-satunya server yang boleh mengirim sebagai @lummy.id (docs/config/04). Balasan
# selalu diarahkan ke team@lummy.id. SMTP_PASSWORD RAHASIA, server saja. Port 465 (SSL) atau 587.
# SMTP_HOST=mx9.mailspace.id
# SMTP_PORT=465
# SMTP_USER=no-reply@lummy.id
# SMTP_PASSWORD=
# MAIL_FROM=Lummy <no-reply@lummy.id>
# Cuma untuk npm run email:check di mesin lokal, tidak pernah di Vercel (di sana diabaikan): tiap
# email ditulis jadi file JSON di folder ini, tidak dikirim.
# EMAIL_TRANSPORT=file
# EMAIL_DIR=/tmp/lummy-emails

# Claude (Anthropic API), isi otomatis data tiket dari PDF (opsional). Tanpa ini, penjual mengisi
# sendiri. RAHASIA, server saja. Kuncinya dibuat di satu workspace (lummy-production), bukan untuk semua
# workspace. Simpan dengan web/scripts/set-secret.sh. docs/config/01-claude.md
ANTHROPIC_API_KEY=
# Opsional, bawaannya claude-haiku-5-5.
# CLAUDE_MODEL=
# Gemini, cuma untuk tiket karangan di tier gratis (npm run ai:eval -- --provider gemini). Jangan dipasang
# di server yang menerima PDF asli: isi tier gratis boleh dipakai Google untuk melatih produknya.
# docs/config/01-gemini.md
# GEMINI_API_KEY=
# Opsional: claude, gemini, fake (tes, tanpa kunci), atau off. Tanpa ini: Claude kalau kuncinya ada,
# lalu Gemini.
# AI_PROVIDER=


# Opsional. Default: Arbitrum Sepolia, alamat dari src/lib/chain/deployments.ts, 1 USDC per pesanan.
# LUMMY_CHAIN_ID=421614
# LUMMY_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
# LUMMY_ESCROW=
# LUMMY_TOKEN=
# LUMMY_LEDGER=
# LUMMY_DEMO_PRICE_USDC=1
