# Contoh env untuk deploy dan verifikasi kontrak. Di mesin Luthfi nilai aslinya ada di
# ~/.lummy/testnet.env (di luar repo). Kalau mau file lokal di sini, salin jadi contracts/.env
# (di-ignore git). Kunci TESTNET saja; jangan pernah kunci mainnet di file.

# Verifikasi kode di Arbiscan: satu kunci Etherscan API V2 dari etherscan.io berlaku untuk
# Arbitrum Sepolia juga. docs/config/03-verifikasi-kontrak.md
ETHERSCAN_API_KEY=

# Deploy (script/Deploy.s.sol). ADMIN dan OPERATOR wajib.
ADMIN=                      # pemegang role admin; produksi: Safe 2-of-3
OPERATOR=                   # kunci panas yang mengirim transaksi atas nama pengguna (Model A)
TOKEN=                      # kosong = ikut deploy MockUSDC. Arbitrum Sepolia: USDC Circle 0x75faf114eafb1BDbe2F0316DF893fd58CE46AA4d
# PRICE_CAP=5000000000      # default 5.000 USDC (6 desimal)
# DISPUTE_WINDOW=600        # default 600 detik untuk demo; di Arbitrum One skrip cuma menerima 172800
# DEPLOY_NAME=              # default chainId; nama file di deployments/

# Kunci pengirim deploy dioper lewat --private-key, bukan dibaca skrip. Dari testnet.env:
# DEPLOYER_PRIVATE_KEY=
